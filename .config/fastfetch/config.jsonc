{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$XDG_CONFIG_HOME/fastfetch/logo/logo-2.png",
    // "color": {
    //   "1": "32"
    // },
    "width": 28,
    "padding": {
      "left": 1,
      "right": 1,
      "top": 1
    }
    

  },
  "display": {
    "separator": "  "
  },
  "modules": [
    { 
      "type": "custom"
    },
    { 
      "type": "custom"
    },
    {
      "type": "OS",
      "key": "{#32}OS  ",
      "format": "{name}"
    },
    {
      "type": "wm",
      "key": "{#32}WM  ",
      "format": "{pretty-name}"
    },
    {
      "type": "title",
      "key": "{#32}USR ",
      "format": "{user-name}"
    },
    {
      "type": "kernel",
      "key": "{#32}KER ",
      "format": "{release}"
    },
    {
      "type": "display",
      "key": "{#32}DSP ",
      "format": "{width}x{height} @{refresh-rate}Hz"
    },
    {
      "type": "terminal",
      "key": "{#32}TER ",
      "format": "{pretty-name}"
    },

    {
      "type": "cpu",
      "key": "{#32}CPU ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "{#32}GPU ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#32}MEM ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "{#32}DSK ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },

    {
      "type": "custom",
      "format": ""
    },

    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    },
    // Footer
    {
      "type": "custom",
      "format": ""
    }
  ]
}
