#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: "{{ colors.surface_container_low.default.hex }}",
    modal_backdrop: false,
    preview_label_style: (fg: "{{ colors.on_surface_variant.default.hex }}"),
    preview_metadata_group_style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
    highlighted_item_style: (fg: "{{ colors.primary.default.hex }}", bg: "{{ colors.surface_container.default.hex }}", modifiers: "Bold"),
    current_item_style: (fg: "{{ colors.on_primary.default.hex }}", bg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
    borders_style: (fg: "{{ colors.outline_variant.default.hex }}"),
    highlight_border_style: (fg: "{{ colors.primary.default.hex }}"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "{{ colors.primary.default.hex }}"),
        warn: (fg: "{{ colors.tertiary.default.hex }}"),
        error: (fg: "{{ colors.error.default.hex }}"),
        debug: (fg: "{{ colors.secondary.default.hex }}"),
        trace: (fg: "{{ colors.outline_variant.default.hex }}"),
    ),
    progress_bar: (
        symbols: ["■", "■", "■", "■", "■"],

        track_style: (fg: "{{ colors.on_secondary.default.hex }}"),
        elapsed_style: (fg: "{{ colors.primary.default.hex }}"),
        thumb_style: (fg: "{{ colors.primary.default.hex }}"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "{{ colors.surface_variant.default.hex }}"),
        ends_style: (fg: "{{ colors.outline.default.hex }}"),
        thumb_style: (fg: "{{ colors.primary.default.hex }}"),
    ),
    tab_bar: (
        active_style: (fg: "{{ colors.on_primary.default.hex }}", bg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
    ),
    cava: (
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],
        inverted_bar_as_mask: false,
    
        bar_width: 1,
        bar_spacing: 1,
        orientation: Bottom,
        bar_color: Single("{{ colors.primary.default.hex }}"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "65%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "{{ colors.on_surface_variant.default.hex }}"),
                default: (kind: Text("Unknown"), style: (fg: "{{ colors.on_surface_variant.default.hex }}"))
            ),
            label_prop: (kind: Text("Album")),
            width: "0%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Len")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            // playing info (2 content rows + top border), joined to the bar below
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "30%",
                            borders: "TOP | LEFT",
                            border_symbols: Rounded,
                            pane: Component("header_left"),
                        ),
                        (
                            size: "48%",
                            borders: "TOP",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs /"))],
                            border_title_alignment: Right,
                            pane: Component("header_center"),
                        ),
                        (
                            size: "22%",
                            borders: "TOP | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                            border_title_alignment: Left,
                            pane: Component("header_right"),
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "7",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "├", top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Inherited(parent: Rounded, top_right: "┤"),
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "{{ colors.primary.default.hex }}"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "{{ colors.primary.default.hex }}"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(Elapsed)), style: (fg: "{{ colors.on_surface_variant.default.hex }}")), 
                (kind: Text(" / "), style: (fg: "{{ colors.outline.default.hex }}")), 
                (kind: Property(Status(Duration)), style: (fg: "{{ colors.on_surface_variant.default.hex }}")), 
                (kind: Group([
                    (kind: Text(" ("), style: (fg: "{{ colors.outline.default.hex }}")), 
                    (kind: Property(Status(Bitrate)), style: (fg: "{{ colors.on_surface_variant.default.hex }}")), 
                    (kind: Text(" kbps)"), style: (fg: "{{ colors.outline.default.hex }}")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "{{ colors.tertiary.default.hex }}", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "{{ colors.tertiary.default.hex }}", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), style: (fg: "{{ colors.on_surface_variant.default.hex }}"), default: (kind: Text("Unknown Album"), style: (fg: "{{ colors.on_surface_variant.default.hex }}"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "{{ colors.primary.default.hex }}"), align: Left)]))
                ),
                (
                    size: "8",
                    pane: Pane(Property(content: [
                        (kind: Property(Status(RepeatV2(
                            on_label: "󰑖",
                            off_label: "󰑖",
                            on_style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
                            off_style: (fg: "{{ colors.outline.default.hex }}", modifiers: "Dim"),
                        )))),
                        (kind: Text(" ")),
                        (kind: Property(Status(RandomV2(
                            on_label: "󰒝",
                            off_label: "󰒝",
                            on_style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
                            off_style: (fg: "{{ colors.outline.default.hex }}", modifiers: "Dim"),
                        )))),
                        (kind: Text(" ")),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "󰐓",
                            off_label: "󰐓",
                            oneshot_label: "󰐓",
                            on_style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
                            off_style: (fg: "{{ colors.outline.default.hex }}", modifiers: "Dim"),
                            oneshot_style: (fg: "{{ colors.error.default.hex }}", modifiers: "Dim"),
                        )))),
                        (kind: Text(" ")),
                        (kind: Property(Status(SingleV2(
                            on_label: "󰑘",
                            off_label: "󰑘",
                            oneshot_label: "󰑘",
                            on_style: (fg: "{{ colors.primary.default.hex }}", modifiers: "Bold"),
                            off_style: (fg: "{{ colors.outline.default.hex }}", modifiers: "Dim"),
                            oneshot_style: (fg: "{{ colors.error.default.hex }}", modifiers: "Bold"),
                        )))),
                        (kind: Text(" ")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Property(Status(StateV2(
                    playing_label: "  ",
                    paused_label:  "  ",
                    stopped_label: "  ",
                    playing_style: (fg: "{{ colors.primary.default.hex }}", bg: "{{ colors.background.default.hex }}", modifiers: "Bold"),
                    paused_style:  (fg: "{{ colors.tertiary.default.hex }}", bg: "{{ colors.background.default.hex }}", modifiers: "Bold"),
                    stopped_style: (fg: "{{ colors.error.default.hex }}", bg: "{{ colors.background.default.hex }}", modifiers: "Bold"),
                ))))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
